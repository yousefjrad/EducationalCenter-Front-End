import { useMemo, useState } from 'react'
import { BookOpen, Plus, Pencil, Power, Layers } from 'lucide-react'
import { toast } from 'sonner'
import { useStore, useCan } from '@/store/AppStore'
import { useI18n } from '@/lib/i18n'
import type { Course, CourseLevel } from '@/types'
import { PageHeader, SearchInput, EmptyState, Pill, Field, TableScroll, Th, Td } from '@/components/shared'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Textarea } from '@/components/ui/textarea'
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter } from '@/components/ui/dialog'
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select'

const LEVELS: CourseLevel[] = ['beginner', 'intermediate', 'advanced', 'all']
const levelTone: Record<CourseLevel, 'green' | 'blue' | 'purple' | 'gray'> = {
  beginner: 'green', intermediate: 'blue', advanced: 'purple', all: 'gray',
}

const emptyForm = { name: '', nameEn: '', description: '', level: 'beginner' as CourseLevel }

export default function Courses() {
  const { t } = useI18n()
  const { state, dispatch } = useStore()
  const canManage = useCan('Courses.Manage')
  const [q, setQ] = useState('')
  const [open, setOpen] = useState(false)
  const [editing, setEditing] = useState<Course | null>(null)
  const [form, setForm] = useState(emptyForm)

  const list = useMemo(
    () => state.courses.filter((c) => (c.name + c.nameEn + c.description).includes(q.trim())),
    [state.courses, q],
  )

  const openNew = () => { setEditing(null); setForm(emptyForm); setOpen(true) }
  const openEdit = (c: Course) => {
    setEditing(c)
    setForm({ name: c.name, nameEn: c.nameEn, description: c.description, level: c.level })
    setOpen(true)
  }

  const save = () => {
    if (!form.name.trim()) { toast.error(t('common.required')); return }
    const course: Course = editing
      ? { ...editing, ...form, name: form.name.trim() }
      : { id: 0, ...form, name: form.name.trim(), active: true }
    dispatch({ type: 'SAVE_COURSE', course })
    toast.success(t('common.saved'))
    setOpen(false)
  }

  const toggleActive = (c: Course) => {
    dispatch({ type: 'SAVE_COURSE', course: { ...c, active: !c.active } })
    toast.success(t(c.active ? 'courses.deactivated' : 'courses.activated'))
  }

  return (
    <div>
      <PageHeader
        title={t('courses.title')} subtitle={t('courses.subtitle')}
        actions={canManage && (
          <Button className="min-h-[44px]" onClick={openNew}><Plus className="me-2 h-4 w-4" />{t('courses.add')}</Button>
        )}
      />

      <SearchInput value={q} onChange={setQ} className="mb-4 max-w-sm" />

      {list.length === 0 ? (
        <EmptyState message={q ? t('common.noResults') : t('courses.empty')} icon={<BookOpen className="h-10 w-10" strokeWidth={1.2} />} />
      ) : (
        <>
          {/* cards on mobile */}
          <div className="grid gap-3 md:hidden">
            {list.map((c) => {
              const secs = state.sections.filter((s) => s.courseId === c.id)
              return (
                <div key={c.id} className="rounded-xl border bg-card p-4 shadow-sm">
                  <div className="flex items-start justify-between gap-2">
                    <div className="min-w-0">
                      <div className="font-extrabold">{c.name}</div>
                      <div className="text-xs text-muted-foreground" dir="ltr">{c.nameEn}</div>
                    </div>
                    <Pill tone={levelTone[c.level]}>{t(`courses.level.${c.level}`)}</Pill>
                  </div>
                  <p className="mt-2 line-clamp-2 text-sm text-muted-foreground">{c.description}</p>
                  <div className="mt-3 flex items-center justify-between">
                    <span className="flex items-center gap-1 text-xs text-muted-foreground"><Layers className="h-3.5 w-3.5" />{secs.length} {t('courses.sectionsCount')}</span>
                    {canManage && (
                      <div className="flex gap-1">
                        <Button variant="ghost" size="icon" className="h-11 w-11" onClick={() => openEdit(c)}><Pencil className="h-4 w-4" /></Button>
                        <Button variant="ghost" size="icon" className={cnActive(c.active)} onClick={() => toggleActive(c)}><Power className="h-4 w-4" /></Button>
                      </div>
                    )}
                  </div>
                  {!c.active && <Pill tone="gray" className="mt-2">{t('common.inactive')}</Pill>}
                </div>
              )
            })}
          </div>

          {/* table on desktop */}
          <div className="hidden md:block">
            <TableScroll>
              <table className="w-full min-w-[720px]">
                <thead>
                  <tr>
                    <Th>{t('common.name')}</Th>
                    <Th>{t('courses.description')}</Th>
                    <Th>{t('courses.level')}</Th>
                    <Th>{t('nav.sections')}</Th>
                    <Th>{t('common.status')}</Th>
                    {canManage && <Th>{t('common.actions')}</Th>}
                  </tr>
                </thead>
                <tbody>
                  {list.map((c) => {
                    const secs = state.sections.filter((s) => s.courseId === c.id)
                    return (
                      <tr key={c.id} className="border-b last:border-0 hover:bg-muted/40">
                        <Td>
                          <div className="font-bold">{c.name}</div>
                          <div className="text-xs text-muted-foreground" dir="ltr">{c.nameEn}</div>
                        </Td>
                        <Td className="max-w-[320px]"><span className="line-clamp-2 text-muted-foreground">{c.description}</span></Td>
                        <Td><Pill tone={levelTone[c.level]}>{t(`courses.level.${c.level}`)}</Pill></Td>
                        <Td><span className="tnum">{secs.length}</span></Td>
                        <Td>{c.active ? <Pill tone="green">{t('common.active')}</Pill> : <Pill tone="gray">{t('common.inactive')}</Pill>}</Td>
                        {canManage && (
                          <Td>
                            <div className="flex gap-1">
                              <Button variant="ghost" size="icon" className="h-9 w-9" onClick={() => openEdit(c)}><Pencil className="h-4 w-4" /></Button>
                              <Button variant="ghost" size="icon" className={cnActive(c.active)} onClick={() => toggleActive(c)}><Power className="h-4 w-4" /></Button>
                            </div>
                          </Td>
                        )}
                      </tr>
                    )
                  })}
                </tbody>
              </table>
            </TableScroll>
          </div>
        </>
      )}

      <Dialog open={open} onOpenChange={setOpen}>
        <DialogContent className="max-w-lg">
          <DialogHeader>
            <DialogTitle>{editing ? t('courses.edit') : t('courses.add')}</DialogTitle>
          </DialogHeader>
          <div className="space-y-4">
            <Field label={t('courses.nameAr')} required>
              <Input className="min-h-[44px]" value={form.name} onChange={(e) => setForm({ ...form, name: e.target.value })} />
            </Field>
            <Field label={t('courses.nameEn')}>
              <Input dir="ltr" className="min-h-[44px]" value={form.nameEn} onChange={(e) => setForm({ ...form, nameEn: e.target.value })} />
            </Field>
            <Field label={t('courses.description')}>
              <Textarea rows={3} value={form.description} onChange={(e) => setForm({ ...form, description: e.target.value })} />
            </Field>
            <Field label={t('courses.level')}>
              <Select value={form.level} onValueChange={(v) => setForm({ ...form, level: v as CourseLevel })}>
                <SelectTrigger className="min-h-[44px]"><SelectValue /></SelectTrigger>
                <SelectContent>
                  {LEVELS.map((l) => <SelectItem key={l} value={l}>{t(`courses.level.${l}`)}</SelectItem>)}
                </SelectContent>
              </Select>
            </Field>
          </div>
          <DialogFooter className="gap-2">
            <Button variant="outline" className="min-h-[44px]" onClick={() => setOpen(false)}>{t('common.cancel')}</Button>
            <Button className="min-h-[44px]" onClick={save}>{t('common.save')}</Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  )
}

function cnActive(active: boolean) {
  return active ? 'h-9 w-9 text-destructive' : 'h-9 w-9 text-[hsl(var(--success))]'
}

// re-export for TS isolatedModules friendliness
export type { Course }
